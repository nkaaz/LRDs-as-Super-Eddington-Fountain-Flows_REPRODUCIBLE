From c0d1fd9390b53e0563f7ea4e034c8b40c50ae8eb Mon Sep 17 00:00:00 2001
From: Nick Kaaz <nk6352@stellar-intel.princeton.edu>
Date: Thu, 9 Jul 2026 15:17:19 -0400
Subject: [PATCH 3/6] Raise per-cell J_nu resolution: NBINS_IN_CELL_SPEC 1000
 -> 3000

Finer cell_spec_flux grid for the per-cell mean-intensity J_nu diagnostics
(inset panels). With the custom-band photon sampling the fixed bin count now
spans ~3.3 decades ([0.05,100] eV) instead of ~10, so 3000 bins gives ~900
bins/decade at the Balmer/Lyman edges.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 source/sirocco.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/source/sirocco.h b/source/sirocco.h
index e5220fbf..53979472 100644
--- a/source/sirocco.h
+++ b/source/sirocco.h
@@ -567,7 +567,7 @@ struct geometry
   int nxfreq;                   /**<  the number of frequency intervals actually used */
   double xfreq[NXBANDS + 1];    /**<  the frequency boundaries for the coarse spectra  */
 
-#define NBINS_IN_CELL_SPEC   1000       /**< The number of bins in the cell spectra  */
+#define NBINS_IN_CELL_SPEC   3000       /**< The number of bins in the cell spectra  */
 
   double cell_log_freq_min, cell_log_freq_max, cell_delta_lfreq;        /**< Parameters defining freqency intervals for cell spectra.
                                                                            These are defined as logarithmic frequency intervals */
